<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="004_2767_change_pages_to_be_child_of_comic_details.xml" author="mcpierce">

        <preConditions onFail="MARK_RAN">
            <columnExists tableName="comic_pages_v4" columnName="comic_book_id"/>
        </preConditions>

        <addColumn tableName="comic_pages_v4">
            <column name="comic_detail_id" type="bigint"/>
        </addColumn>

        <sql>
            UPDATE comic_pages_v4
            SET comic_detail_id=(SELECT comic_detail_id
                                 FROM comic_details_v4
                                 WHERE comic_details_v4.comic_book_id = comic_pages_v4.comic_book_id);
        </sql>

        <addNotNullConstraint tableName="comic_pages_v4" columnName="comic_detail_id" columnDataType="bigint"/>

        <dropView viewName="duplicate_pages_view"/>

        <dropView viewName="displayable_comics_view"/>

        <dropForeignKeyConstraint baseTableName="comic_pages_v4" constraintName="comic_pages_v4_comic_book_fk"/>

        <dropIndex tableName="comic_pages_v4" indexName="comic_pages_v4_comic_book_and_page_number_idx"/>

        <dropColumn tableName="comic_pages_v4" columnName="comic_book_id"/>

        <addForeignKeyConstraint baseTableName="comic_pages_v4" baseColumnNames="comic_detail_id"
                                 constraintName="comic_pages_v4_comic_detail_fk"
                                 referencedTableName="comic_details_v4"
                                 referencedColumnNames="comic_detail_id"/>

        <addUniqueConstraint tableName="comic_pages_v4"
                             constraintName="comic_pages_v4_unique_comic_detail_and_page_number"
                             columnNames="comic_detail_id,page_number"/>

    </changeSet>
</databaseChangeLog>
