<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="009_2785_create_the_comics_table.xml" author="mcpierce">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="comics_v4"/>
            </not>
        </preConditions>

        <createTable tableName="comics_v4">
            <column name="comic_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="comics_v4_pk"/>
            </column>

            <column name="comic_detail_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="archive_type" type="varchar(4)">
                <constraints nullable="false"/>
            </column>

            <column name="target_archive_type" type="varchar(4)">
                <constraints nullable="true"/>
            </column>

            <column name="comic_state" type="char(64)">
                <constraints nullable="true"/>
            </column>

            <column name="comic_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="publisher" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="imprint" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="series" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="volume" type="varchar(4)">
                <constraints nullable="true"/>
            </column>

            <column name="issue_number" type="varchar(16)">
                <constraints nullable="true"/>
            </column>

            <column name="cover_date" type="date">
                <constraints nullable="true"/>
            </column>

            <column name="store_date" type="date">
                <constraints nullable="true"/>
            </column>

            <column name="added_date" type="date">
                <constraints nullable="true"/>
            </column>

            <column name="filename" type="varchar(768)">
                <constraints nullable="false" unique="true" uniqueConstraintName="comics_v4_unique_filename"/>
            </column>

            <column name="title" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="notes" type="varchar(1024)">
                <constraints nullable="true"/>
            </column>

            <column name="description" type="clob">
                <constraints nullable="true"/>
            </column>

            <column name="sort_name" type="varchar(32)">
                <constraints nullable="true"/>
            </column>

            <column name="web_address" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="missing" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="last_modified_date" type="datetime">
                <constraints nullable="true"/>
            </column>

            <column name="loading_file_contents" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="updating_metadata" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="batch_updating_metadata" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="batch_scraping" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="organizing" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="purging" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="editing_metadata" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="comics_v4" indexName="comics_v4_filename_idx">
            <column name="filename"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_filtered_idx">
            <column name="cover_date"/>
            <column name="archive_type"/>
            <column name="comic_type"/>
            <column name="comic_state"/>
            <column name="publisher"/>
            <column name="series"/>
            <column name="volume"/>
            <column name="issue_number"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_cover_date_idx">
            <column name="publisher"/>
            <column name="cover_date"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_idx">
            <column name="publisher"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_series_idx">
            <column name="series"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_series_idx">
            <column name="publisher"/>
            <column name="series"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_series_volume_idx">
            <column name="publisher"/>
            <column name="series"/>
            <column name="volume"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_series_volume_issue_number_idx">
            <column name="publisher"/>
            <column name="series"/>
            <column name="volume"/>
            <column name="issue_number"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_publisher_series_volume_issue_number_cover_date_idx">
            <column name="publisher"/>
            <column name="series"/>
            <column name="volume"/>
            <column name="issue_number"/>
            <column name="cover_date"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_sort_name_idx">
            <column name="sort_name"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_volume_idx">
            <column name="volume"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_loading_file_contents_idx">
            <column name="loading_file_contents"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_updating_metadata_idx">
            <column name="updating_metadata"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_batch_updating_metadata_idx">
            <column name="batch_updating_metadata"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_batch_scraping_idx">
            <column name="batch_scraping"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_organizing_idx">
            <column name="organizing"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_purging_idx">
            <column name="purging"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_target_archive_type_idx">
            <column name="target_archive_type"/>
        </createIndex>

        <createIndex tableName="comics_v4" indexName="comics_v4_editing_metadata_idx">
            <column name="editing_metadata"/>
        </createIndex>

        <sql>
            INSERT INTO comics_v4(comic_detail_id, archive_type, comic_state, publisher, imprint, series, volume,
                                  issue_number, cover_date, store_date, added_date, filename, title, notes, description,
                                  sort_name, comic_type, web_address, missing, last_modified_Date,
                                  loading_file_contents, updating_metadata, batch_updating_metadata, batch_scraping,
                                  organizing, purging, editing_metadata, target_archive_type)
            SELECT comic_detail_id,
                   archive_type,
                   comic_state,
                   publisher,
                   imprint,
                   series,
                   volume,
                   issue_number,
                   cover_date,
                   store_date,
                   added_date,
                   filename,
                   title,
                   notes,
                   description,
                   sort_name,
                   comic_type,
                   web_address,
                   missing,
                   last_modified_Date,
                   loading_file_contents,
                   updating_metadata,
                   batch_updating_metadata,
                   batch_scraping,
                   organizing,
                   purging,
                   editing_metadata,
                   target_archive_type
            FROM comic_details_v4;
        </sql>

    </changeSet>
</databaseChangeLog>
