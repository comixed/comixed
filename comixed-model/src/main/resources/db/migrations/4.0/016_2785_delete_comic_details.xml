<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="016_2785_delete_comic_details.xml" author="mcpierce">

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="comic_details_v4"/>
            <not>
                <columnExists tableName="comics_v4" columnName="comic_detail_id"/>
            </not>
        </preConditions>

        <dropIndex tableName="comics_v4" indexName="comics_v4_comic_detail_idx"/>
        <dropColumn tableName="comics_v4" columnName="comic_detail_id"/>
        <dropTable tableName="comic_details_v4"/>

    </changeSet>
</databaseChangeLog>
